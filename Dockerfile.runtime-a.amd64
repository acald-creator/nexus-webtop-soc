#
# Runtime-a candidate: first true non-LinuxServer runtime baseline.
# This is a plumbing candidate to validate build/publish/compose integration.
# It is not feature-parity with the XFCE analyst desktop yet.
#
FROM --platform=amd64 cgr.dev/chainguard/wolfi-base:latest

ARG VERSION
ENV VERSION=$VERSION
ARG BUILD_TIMESTAMP
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP

LABEL description="Nexus Webtop SOC runtime-a candidate (non-LinuxServer runtime baseline)."
LABEL org.opencontainers.image.vendor="Fenix Secure Labs"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

RUN apk add --no-cache bash curl git nginx

RUN addgroup -S nginx && adduser -S -D -H -G nginx nginx

RUN mkdir -p /var/lib/nginx/tmp /run/nginx /usr/share/nginx/html

RUN cat > /etc/nginx/nginx.conf <<'EOF'
worker_processes auto;
pid /run/nginx/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;

  server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;

    location = /healthz {
      default_type text/plain;
      return 200 "ok\n";
    }

    location / {
      return 404;
    }
  }
}
EOF

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
