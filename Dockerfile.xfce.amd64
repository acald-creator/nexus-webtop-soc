FROM --platform=amd64 linuxserver/webtop:amd64-ubuntu-xfce

ARG VERSION
ENV VERSION=$VERSION
ARG BUILD_TIMESTAMP
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP
ARG INSTALL_GITKRAKEN=0

LABEL description="Nexus Webtop SOC analyst desktop for Underground Nexus. SOC runtime services run as dedicated workloads."

VOLUME ["/config", "/nexus-bucket"]

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        ca-certificates \
        libnotify4 \
        xdg-utils \
        curl \
        wget \
        vim \
        git \
        libnss3 \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "$INSTALL_GITKRAKEN" = "1" ]; then \
      wget -q https://release.gitkraken.com/linux/gitkraken-amd64.deb && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ./gitkraken-amd64.deb && \
      rm -f gitkraken-amd64.deb ; \
    fi

EXPOSE 3000
